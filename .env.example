# ===== 应用 =====
APP_NAME=企业知识库 RAG 问答系统
DEBUG=false
API_PORT=8000
LOG_LEVEL=INFO
# uvicorn worker 数（Dockerfile 的 CMD 读取）。4 × (5+10)=60 条 DB 连接，低于 MySQL 默认 151
API_WORKERS=4
# 公网部署（Caddy）使用的域名；本地开发可保持示例值或留空
PUBLIC_DOMAIN=rag.example.com

# ===== 访客表单登录 =====
# 访客账号文件（compose.vps.yml 会把它只读挂到 /etc/rag-demo）
DEMO_ACCOUNTS_FILE=/etc/rag-demo/guests.caddy
# Cookie 签名密钥；公网部署用 openssl rand -hex 32 生成后填入。
# 留空时进程启动会生成随机值，重启后所有访客会话失效。
DEMO_SESSION_SECRET=
# 本地 HTTP 测试可设为 false；公网 HTTPS 保持 true
DEMO_COOKIE_SECURE=true

# ===== MySQL =====
# host/port 不在这里 —— 由 docker-compose 的 environment 指定成服务名（mysql:3306）。
# 这个项目只在 compose 里跑，所以口径只有一份；这里只放账号与库名。
DB_USER=app
# 公网部署务必改强口令；本地默认 app
DB_PASSWORD=app
DB_NAME=rag_ingest
# MySQL root 密码：本地默认 root123456；公网部署务必改
MYSQL_ROOT_PASSWORD=root123456
# 每个 worker 的连接池；总连接数 = API_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ===== Redis =====
# 同理：host/port/db 也都在 compose 里（redis:6379、db 0；测试容器用 db 15）
# 每进程连接池上限，应 ≥ 单进程最大并发（DB 池单进程上限是 10+20=30）
REDIS_MAX_CONNECTIONS=50

# ===== 业务参数 =====
CACHE_TTL=60
LOCK_TTL_MS=10000
# bulk 入口每多少篇提交一次事务（1 = 逐篇提交，退回旧行为）
BULK_COMMIT_SIZE=10
# 多行写入：片内身份/内容唯一时用多行 INSERT；false 退回逐篇切片
BULK_MULTIROW_ENABLED=true
# 单批最多多少 chunk 行（超过就退回逐篇，防大事务/包过大）
BULK_MAX_CHUNK_ROWS=2000
# ===== 后台任务 =====
RECLAIM_INTERVAL_SECONDS=60
RECLAIM_AFTER_SECONDS=300

# ===== enrich（阶段 H）=====
# provider 四档：rule（纯 Python）/ model（自定契约的 HTTP 上游）/ openai_compat（OpenAI 兼容）/ off
ENRICH_PROVIDER=rule
# `model` 档：上游地址。compose 里已指到 model 服务（http://model:8000/enrich）；换上游时改它
ENRICH_MODEL_URL=http://model:8000/enrich
# `openai_compat` 档：基址 + 端点路径 + 要哪个模型 + 可选的 key
ENRICH_OPENAI_BASE_URL=http://model:8000
# 端点路径做成可配：多数厂商是 /v1/chat/completions，但智谱 GLM 是 /api/paas/v4/chat/completions
ENRICH_OPENAI_PATH=/v1/chat/completions
ENRICH_MODEL_NAME=fake-model
# key 留空即可 —— 自建推理（Ollama / vLLM）不需要，云厂商兼容端点才需要
ENRICH_API_KEY=
# 让上游按 JSON 约束输出（DeepSeek / 通义 / GLM 支持；不支持的服务会 400 → 那一档不可用）
ENRICH_JSON_MODE=false
# 发给上游的正文先截到这个长度（首段 + 尾段）—— 长文档按输入全长计费，整篇发是白烧钱
ENRICH_SAMPLE_LIMIT=4000
# 摘要不该无限长；也是成本闸门
ENRICH_MAX_TOKENS=512
# 默认 5 秒对云厂商太紧 —— 而超时的表现是"静默回落到规则"，会被误判成"没接上"，接真厂商时调大
ENRICH_TIMEOUT_SECONDS=5
ENRICH_INTERVAL_SECONDS=30
ENRICH_BATCH_SIZE=50

# ---- 接真厂商的例子（以 DeepSeek 为例）----
# 把上面几项换成这组，再把 key 填进你的 .env（别填进这个文件 —— 它是要提交的）：
#   ENRICH_PROVIDER=openai_compat
#   ENRICH_OPENAI_BASE_URL=https://api.deepseek.com
#   ENRICH_MODEL_NAME=deepseek-chat
#   ENRICH_JSON_MODE=true
#   ENRICH_TIMEOUT_SECONDS=20
# 完整步骤（含"先直接打一次厂商 API"的探活与判别特征）见 README 快速开始第 6 节。

# ===== 应用角色 / 真实下游 =====
# all = 本地默认（摄入 + 检索问答都挂）；ingest = 只写（api 容器）；rag = 只读（rag-api 容器）
APP_ROLE=all
# ===== embedding =====
# provider 三档：hash（无模型词法哈希，离线兜底/测试）/ fastembed（本地 ONNX，默认）/ openai_compat（向量端点）
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 维度必须与模型一致，也要与 Qdrant 集合的 size 对齐；换维度要新建集合
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=10
# fastembed 的 ONNX 模型缓存目录（compose 里挂了命名卷，重建不必重新下载）
EMBEDDING_CACHE_DIR=/models/fastembed
# 宿主机模型目录：先运行 scripts\fetch_embedding_model.cmd
# 目录里必须有 model_optimized.onnx（fastembed 的 ONNX 模型）
EMBEDDING_MODEL_HOST_PATH=./models/bge-small-zh-v1.5
# 容器内路径由 compose 固定为 /models/bge-small-zh-v1.5；填了它就不再联网下载
EMBEDDING_MODEL_PATH=/models/bge-small-zh-v1.5
# 有本地模型时设为 1，禁止 huggingface_hub 再做任何网络探测
HF_HUB_OFFLINE=1
# openai_compat 档才用
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_PATH=/v1/embeddings
# ===== Qdrant =====
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# 集合名带版本：换模型 / 维度时新建集合再切配置，不做原地改维度
QDRANT_COLLECTION=document_chunks_v1
QDRANT_TIMEOUT_SECONDS=10
# ===== LLM =====
# openai_compat 覆盖 Ollama / vLLM / 云厂商兼容端点；extractive 是无模型兜底
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:3b-instruct
LLM_API_KEY=
LLM_PATH=/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
# 拼 prompt 时可用的上下文预算（token），超了按分数从低往高截掉片段
LLM_CONTEXT_TOKENS=6000
# ===== 失败重试 / 缓存 =====
# 同一 chunk 连续失败到上限转 failed 终态（毒丸）；退避基数按 2 的幂次增长
MAX_EMBED_ATTEMPTS=3
EMBED_BACKOFF_SECONDS=5
QA_CACHE_ENABLED=true
QA_CACHE_TTL=3600
# prompt 模板版本：改了模板就 +1，让旧缓存键自然失效
PROMPT_VERSION=1
RETRIEVAL_TOP_K=5
# 低于该分数的召回判为证据不足（0 = 不启用；阈值要用评测集校准，别拍脑袋）
RETRIEVAL_SCORE_THRESHOLD=0
